APP_NAME="RAG-system"
APP_VERSION="0.1.0"
OPENAI_API_KEY="your_openai_api_key_here"
FILE_ALLOWED_TYPES="text/plain,application/pdf"
FILE_MAX_SIZE_MB=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512 kb

MONGODB_URL="mongodb://user:pass@localhost:27037"
MONGODB_DB_NAME="rag-system"

# ======================== LLM config ========================
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=""
COHERE_API_KEY=""
"
GENERATION_MODEL_ID=""
EMBEDDING_MODEL_ID=""
EMBEDDING_MODEL_SIZE=""

DEFAULT_INPUT_MAX_CHARACTER=1024
DEFAULT_GENERATION_MAX_OUTPUT_TOKENS=200
DEFAULT_GENERATION_TEMPERATURE=0.1

# ===================== Vector DB config =====================
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DITANCE_METHOD="cosine"
